<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bjarmkirja — Финно-угорская библиотека</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'Georgia', 'Times New Roman', serif;
    background: #faf8f5;
    color: #1a1a1a;
  }

  /* SVG-звезда (восьмиугольная, как на флаге Удмуртии) */
  .star-icon {
    width: 36px; height: 36px;
    fill: #c41e1e;
  }
  .star-hero {
    width: 64px; height: 64px;
    fill: #c41e1e;
    margin-bottom: 20px;
    filter: drop-shadow(0 0 12px rgba(196,30,30,0.3));
  }

  /* HEADER */
  .site-header { background: #1a1a1a; color: #fff; }
  .header-top {
    display: flex; justify-content: space-between; align-items: center;
    padding: 16px 48px; border-bottom: 1px solid #333;
  }
  .logo-block { display: flex; align-items: center; gap: 14px; }
  .logo-text {
    font-size: 20px; letter-spacing: 3px; text-transform: uppercase;
    color: #f0ebe3;
  }
  .logo-sub {
    font-size: 10px; color: #8b7355; letter-spacing: 4px;
    text-transform: uppercase;
  }
  .nav-links {
    display: flex; gap: 32px; font-size: 12px;
    text-transform: uppercase; letter-spacing: 2px;
    font-family: sans-serif;
  }
  .nav-links a { color: #888; text-decoration: none; }
  .nav-links a:hover { color: #fff; }

  /* HERO */
  .hero {
    padding: 60px 48px; text-align: center; background: #1a1a1a;
  }
  .hero h1 {
    font-size: 48px; font-weight: 300; letter-spacing: 6px;
    text-transform: uppercase; color: #f0ebe3; margin-bottom: 10px;
  }
  .hero .tagline {
    font-size: 16px; color: #8b7355; font-style: italic;
    margin-bottom: 30px;
  }
  .search-box { max-width: 520px; margin: 0 auto; }
  .search-box input {
    width: 100%; padding: 16px 24px; border: 1px solid #444;
    background: #222; color: #fff; font-size: 15px;
    font-family: 'Georgia', serif; outline: none;
  }
  .search-box input:focus { border-color: #c41e1e; }
  .search-box input::placeholder { color: #555; }

  /* STATS */
  .stats-bar {
    display: flex; justify-content: center; gap: 60px;
    padding: 20px 48px; background: #222;
    border-top: 1px solid #333; border-bottom: 1px solid #333;
  }
  .stat-num { font-size: 26px; font-weight: 300; color: #f0ebe3; }
  .stat-label {
    font-size: 10px; text-transform: uppercase; letter-spacing: 2px;
    color: #8b7355; margin-top: 4px; font-family: sans-serif;
  }

  /* FILTERS */
  .filter-bar {
    position: sticky; top: 0; background: #fff;
    padding: 14px 48px; border-bottom: 1px solid #e8e0d4;
    display: flex; gap: 8px; flex-wrap: wrap; z-index: 50;
  }
  .filter-chip {
    padding: 8px 16px; border: 1px solid #e0d8cc; background: #fff;
    cursor: pointer; font-size: 11px; text-transform: uppercase;
    letter-spacing: 1px; font-family: sans-serif; color: #5a4a3a;
  }
  .filter-chip:hover { border-color: #c41e1e; color: #c41e1e; }
  .filter-chip.active { background: #1a1a1a; color: #fff; border-color: #1a1a1a; }

  /* FEATURED */
  .featured-section { padding: 48px; background: #fff; }
  .section-header {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 28px; border-bottom: 2px solid #1a1a1a; padding-bottom: 10px;
  }
  .section-title {
    font-size: 22px; text-transform: uppercase; letter-spacing: 3px;
  }
  .section-more {
    font-size: 12px; text-transform: uppercase; letter-spacing: 2px;
    color: #8b7355; cursor: pointer; font-family: sans-serif;
  }
  .featured-grid {
    display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 20px;
  }
  .feat-card {
    background: #f5f3ef; border: 1px solid #e8e0d4;
    padding: 32px; display: flex; flex-direction: column;
    justify-content: flex-end; min-height: 280px; cursor: pointer;
    transition: transform 0.2s;
  }
  .feat-card:hover { transform: translateY(-3px); }
  .feat-card .label {
    font-size: 11px; text-transform: uppercase; letter-spacing: 2px;
    color: #c41e1e; margin-bottom: 10px; font-family: sans-serif;
  }
  .feat-card h3 {
    font-size: 22px; font-weight: 400; line-height: 1.3; margin-bottom: 8px;
  }
  .feat-card p { font-size: 14px; color: #666; line-height: 1.5; }
  .feat-small h3 { font-size: 16px; }
  .feat-small .meta { font-size: 12px; color: #888; margin-top: 6px; font-family: sans-serif; }

  /* BOOK LIST */
  .list-section { padding: 40px 48px; background: #faf8f5; }
  .book-row {
    display: flex; gap: 20px; padding: 20px 0;
    border-bottom: 1px solid #e8e0d4; align-items: flex-start;
    cursor: pointer; transition: background 0.2s;
  }
  .book-row:hover { background: #f5f3ef; }
  .book-num {
    font-size: 28px; font-weight: 300; color: #ccc;
    min-width: 44px; line-height: 1;
  }
  .book-info h4 { font-size: 17px; font-weight: 400; margin-bottom: 4px; }
  .book-meta { font-size: 13px; color: #888; font-family: sans-serif; margin-bottom: 8px; }
  .book-tags { display: flex; gap: 6px; flex-wrap: wrap; }
  .book-tag {
    font-size: 10px; text-transform: uppercase; letter-spacing: 1px;
    padding: 3px 10px; border: 1px solid #c4b8a8; color: #5a4a3a;
    font-family: sans-serif;
  }
  .book-tag.people { background: #c41e1e; color: #fff; border-color: #c41e1e; }

  /* FOOTER */
  .site-footer {
    background: #1a1a1a; color: #555; padding: 32px 48px;
    text-align: center; font-size: 11px; letter-spacing: 2px;
    text-transform: uppercase; font-family: sans-serif;
  }

  @media (max-width: 900px) {
    .featured-grid { grid-template-columns: 1fr; }
    .header-top, .hero, .stats-bar, .filter-bar,
    .featured-section, .list-section { padding-left: 20px; padding-right: 20px; }
    .hero h1 { font-size: 30px; }
    .stats-bar { gap: 20px; flex-wrap: wrap; }
  }
</style>
</head>
<body>

<!-- SVG: восьмиугольная звезда (флаг Удмуртии) -->
<svg style="display:none;">
  <symbol id="udmurt-star" viewBox="0 0 100 100">
    <rect x="42" y="42" width="16" height="16" fill="currentColor"/>
    <polygon points="50,0 58,15 50,30 42,15" fill="currentColor"/>
    <polygon points="100,50 85,58 70,50 85,42" fill="currentColor"/>
    <polygon points="50,100 42,85 50,70 58,85" fill="currentColor"/>
    <polygon points="0,50 15,42 30,50 15,58" fill="currentColor"/>
    <polygon points="85,15 92,25 78,35 70,22" fill="currentColor"/>
    <polygon points="85,85 70,78 78,65 92,75" fill="currentColor"/>
    <polygon points="15,85 22,70 35,78 25,92" fill="currentColor"/>
    <polygon points="15,15 25,8 35,22 22,30" fill="currentColor"/>
  </symbol>
</svg>

<header class="site-header">
  <div class="header-top">
    <div class="logo-block">
      <svg class="star-icon"><use href="#udmurt-star"/></svg>
      <div>
        <div class="logo-text">Bjarmkirja</div>
        <div class="logo-sub">Финно-угорская библиотека</div>
      </div>
    </div>
    <nav class="nav-links">
      <a href="#catalog">Каталог</a>
      <a href="#peoples">Народы</a>
      <a href="#about">О проекте</a>
    </nav>
  </div>
  <div class="hero">
    <svg class="star-hero"><use href="#udmurt-star"/></svg>
    <h1>Bjarmkirja</h1>
    <p class="tagline">Собрание книг, статей и исследований о народах Урала</p>
    <div class="search-box">
      <input type="text" placeholder="Поиск по названию, автору, народу или языку...">
    </div>
  </div>
  <div class="stats-bar">
    <div><div class="stat-num">247</div><div class="stat-label">Материалов</div></div>
    <div><div class="stat-num">8</div><div class="stat-label">Народов</div></div>
    <div><div class="stat-num">12</div><div class="stat-label">Языков</div></div>
  </div>
</header>

<div class="filter-bar">
  <button class="filter-chip active" onclick="filter('all',this)">Все</button>
  <button class="filter-chip" onclick="filter('марийцы',this)">Марийцы</button>
  <button class="filter-chip" onclick="filter('удмурты',this)">Удмурты</button>
  <button class="filter-chip" onclick="filter('саами',this)">Саами</button>
  <button class="filter-chip" onclick="filter('коми',this)">Коми</button>
  <button class="filter-chip" onclick="filter('мордва',this)">Мордва</button>
  <button class="filter-chip" onclick="filter('венгры',this)">Венгры</button>
  <button class="filter-chip" onclick="filter('финны',this)">Финны</button>
</div>

<section class="featured-section">
  <div class="section-header">
    <h2 class="section-title">Избранное</h2>
    <span class="section-more">Смотреть все →</span>
  </div>
  <div class="featured-grid">
    <div class="feat-card">
      <div class="label">Марийцы · Монография · 2022</div>
      <h3>История и культура марийского народа: от древности до современности</h3>
      <p>Сергеев В.П. — всестороннее исследование истории, языка и традиций.</p>
    </div>
    <div class="feat-card feat-small">
      <div class="label">Удмурты · Словарь · 2014</div>
      <h3>Удмуртско-русский словарь</h3>
      <div class="meta">Кельмаков В.К. · 45 000 слов</div>
    </div>
    <div class="feat-card feat-small">
      <div class="label">Саами · Этнография · 2020</div>
      <h3>The Saami People: Traditions in Transitions</h3>
      <div class="meta">Valkonen J. · University of Helsinki Press</div>
    </div>
  </div>
</section>

<section class="list-section" id="catalog">
  <div class="section-header">
    <h2 class="section-title">Каталог</h2>
    <span class="section-more">Архив →</span>
  </div>

  <div class="book-row" data-people="марийцы">
    <span class="book-num">01</span>
    <div class="book-info">
      <h4>Грамматика марийского языка</h4>
      <div class="book-meta">Иванов И.И. · 2019 · Русский · Учебник</div>
      <div class="book-tags">
        <span class="book-tag people">марийцы</span>
        <span class="book-tag">грамматика</span>
        <span class="book-tag">учебник</span>
      </div>
    </div>
  </div>

  <div class="book-row" data-people="удмурты">
    <span class="book-num">02</span>
    <div class="book-info">
      <h4>Удмуртский фольклор: сборник</h4>
      <div class="book-meta">Петрова А.М. · 2017 · Русский · Сборник</div>
      <div class="book-tags">
        <span class="book-tag people">удмурты</span>
        <span class="book-tag">фольклор</span>
        <span class="book-tag">эпос</span>
      </div>
    </div>
  </div>

  <div class="book-row" data-people="саами">
    <span class="book-num">03</span>
    <div class="book-info">
      <h4>Saami Shamanism and Traditional Knowledge</h4>
      <div class="book-meta">Rydving H. · 2019 · English · Monograph</div>
      <div class="book-tags">
        <span class="book-tag people">саами</span>
        <span class="book-tag">шаманизм</span>
        <span class="book-tag">этнография</span>
      </div>
    </div>
  </div>

  <div class="book-row" data-people="коми">
    <span class="book-num">04</span>
    <div class="book-info">
      <h4>Коми-пермяцкие народные сказки</h4>
      <div class="book-meta">Сборник · 2015 · Русский · Перевод</div>
      <div class="book-tags">
        <span class="book-tag people">коми</span>
        <span class="book-tag">сказки</span>
        <span class="book-tag">перевод</span>
      </div>
    </div>
  </div>

  <div class="book-row" data-people="мордва">
    <span class="book-num">05</span>
    <div class="book-info">
      <h4>Erzya-Moksha Languages: A Comparative Study</h4>
      <div class="book-meta">Rueter J. · 2021 · English · Monograph</div>
      <div class="book-tags">
        <span class="book-tag people">мордва</span>
        <span class="book-tag">лингвистика</span>
        <span class="book-tag">сравнительное</span>
      </div>
    </div>
  </div>

  <div class="book-row" data-people="венгры">
    <span class="book-num">06</span>
    <div class="book-info">
      <h4>Венгерская грамматика в таблицах</h4>
      <div class="book-meta">Ковач Б. · 2018 · Русский · Учебник</div>
      <div class="book-tags">
        <span class="book-tag people">венгры</span>
        <span class="book-tag">грамматика</span>
        <span class="book-tag">учебник</span>
      </div>
    </div>
  </div>

  <div class="book-row" data-people="финны">
    <span class="book-num">07</span>
    <div class="book-info">
      <h4>Finnish Folk Poetry: Epic</h4>
      <div class="book-meta">Honko L. · 2016 · English · Anthology</div>
      <div class="book-tags">
        <span class="book-tag people">финны</span>
        <span class="book-tag">Калевала</span>
        <span class="book-tag">эпос</span>
      </div>
    </div>
  </div>
</section>

<footer class="site-footer">
  <svg class="star-icon" style="width:18px;height:18px;opacity:0.5;margin-bottom:8px;">
    <use href="#udmurt-star"/>
  </svg>
  <div>Bjarmkirja · Финно-угорская библиотека · 2026</div>
</footer>

<script>
function filter(people, btn) {
  document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.book-row').forEach(row => {
    row.style.display = (people === 'all' || row.dataset.people === people) ? 'flex' : 'none';
  });
}
</script>

</body>
</html>
